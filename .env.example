PROMPTGEN_DB_PATH=./data/promptgen.db
PROMPTGEN_RUNS_DIR=./runs
PROMPTGEN_FIXTURES_DIR=./fixtures/private
PROMPTGEN_PUBLIC_WEB=true
PROMPTGEN_ALLOW_PUBLIC_ACCESS=false
# Optional Basic Auth for non-loopback deployments; minimum 12 characters.
# PROMPTGEN_ACCESS_PASSWORD=replace-with-a-long-random-password
PROMPTGEN_MAX_PUBLIC_PAGES=20
PROMPTGEN_REQUEST_TIMEOUT_MS=15000
PROMPTGEN_MODEL_TIMEOUT_MS=300000
PROMPTGEN_JOB_CONCURRENCY=1
# Local development defaults to an in-process worker. Hosted web nodes should set false.
PROMPTGEN_INLINE_WORKER=true
PROMPTGEN_DAILY_AT=02:00
PROMPTGEN_TIMEZONE=UTC
PROMPTGEN_SCHEDULER_ENABLED=false
PROMPTGEN_HOST=127.0.0.1
PROMPTGEN_PORT=4317
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_JUDGE_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PROMPTGEN_EMBEDDING_PROVIDER=openai
PROMPTGEN_EMBEDDING_MODEL=nomic-embed-text
PROMPTGEN_EMBEDDING_DIMENSIONS=768
PROMPTGEN_EMBEDDING_TIMEOUT_MS=5000
PROMPTGEN_EMBEDDING_RUN_LIMIT=500
PROMPTGEN_OLLAMA_URL=http://127.0.0.1:11434
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
PROMPTGEN_MODEL_PROVIDER=auto
GITHUB_TOKEN=

# Hosted metadata is optional locally. Prefer Supabase's IPv4-compatible session pooler.
DATABASE_URL=
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
PROMPTGEN_TENANT_ID=00000000-0000-4000-8000-000000000001
PROMPTGEN_TENANT_NAME=Manicule development
PROMPTGEN_OBJECTS_DIR=./data/objects
# Generate with: openssl rand -base64 32
PROMPTGEN_OBJECT_ENCRYPTION_KEY=
