PROMPTGEN_DB_PATH=./data/promptgen.db
PROMPTGEN_RUNS_DIR=./runs
PROMPTGEN_FIXTURES_DIR=./fixtures/private
PROMPTGEN_PUBLIC_WEB=true
PROMPTGEN_ALLOW_PUBLIC_ACCESS=false
PROMPTGEN_MAX_PUBLIC_PAGES=20
PROMPTGEN_REQUEST_TIMEOUT_MS=15000
PROMPTGEN_MODEL_TIMEOUT_MS=300000
PROMPTGEN_DAILY_AT=02:00
PROMPTGEN_TIMEZONE=UTC
PROMPTGEN_PORT=4317
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_JUDGE_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PROMPTGEN_EMBEDDING_PROVIDER=ollama
PROMPTGEN_EMBEDDING_MODEL=nomic-embed-text
PROMPTGEN_EMBEDDING_DIMENSIONS=768
PROMPTGEN_EMBEDDING_RUN_LIMIT=500
PROMPTGEN_OLLAMA_URL=http://127.0.0.1:11434
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
PROMPTGEN_MODEL_PROVIDER=auto
GITHUB_TOKEN=

# Hosted metadata; prefer Supabase's IPv4-compatible session pooler connection.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASTE_URL_ENCODED_PASSWORD_HERE@aws-0-REGION.pooler.supabase.com:5432/postgres
PGHOST=aws-0-REGION.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.PROJECT_REF
PGPASSWORD=
PROMPTGEN_TENANT_ID=00000000-0000-4000-8000-000000000001
PROMPTGEN_TENANT_NAME=Manicule development
PROMPTGEN_OBJECTS_DIR=./data/objects
# Generate with: openssl rand -base64 32
PROMPTGEN_OBJECT_ENCRYPTION_KEY=
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
