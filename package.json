{
  "name": "manicule-promptgen-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts run-all --fixtures",
    "run": "node dist/src/cli.js",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "scheduler": "tsx src/cli.ts scheduler",
    "serve": "tsx src/cli.ts serve --fixtures",
    "eval": "tsx src/cli.ts eval",
    "eval:prepare": "tsx src/cli.ts eval-prepare",
    "eval:human": "tsx src/cli.ts eval-human",
    "eval:gate": "tsx src/cli.ts eval-gate",
    "eval:annotate": "tsx scripts/annotate-eval.ts",
    "postgres:migrate": "tsx src/cli.ts postgres-migrate",
    "postgres:health": "tsx src/cli.ts postgres-health",
    "postgres:search": "tsx src/cli.ts postgres-search",
    "postgres:embed": "tsx src/cli.ts postgres-embed",
    "backup:verify": "tsx scripts/verify-backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "better-sqlite3": "^12.2.0",
    "openai": "^5.20.0",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
